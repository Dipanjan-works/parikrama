rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: verify the requesting user is the designated admin
    // The admin email is verified server-side from the Firebase Auth token — never from client data.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == "dipanjandhar2006@gmail.com";
    }

    // Helper: ensure no extra/unexpected fields are being written
    function noExtraFields(allowedKeys) {
      return request.resource.data.keys().hasOnly(allowedKeys);
    }

    // ── Pandals Collection ──────────────────────────────────────────────────
    // Public read. Write only by verified admin.
    match /pandals/{pandalId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.zone is string;
      allow delete: if isAdmin();
    }

    // ── Puja Tales Collection ───────────────────────────────────────────────
    // Public read. Write only by verified admin.
    match /pujaTales/{taleId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 300;
      allow delete: if isAdmin();
    }

    // ── User Private Data ───────────────────────────────────────────────────
    // Each user can only read/write their own document tree.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // ── Deny everything else by default ────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
